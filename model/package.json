{
  "name": "swarm-forum-model",
  "private": true,
  "description": "Quint model of the Swarm Forum protocol",
  "license": "MIT",
  "scripts": {
    "typecheck": "for f in $(find . -name '*.qnt' -not -path './node_modules/*' -not -path './_apalache-out/*' -not -path './traces/*' | sort); do echo \"typecheck $f\"; quint typecheck \"$f\" || exit 1; done",
    "test": "for f in $(find tests -name '*_test.qnt' | sort); do case \"$f\" in *_ts_test.qnt) b=typescript ;; *) b=rust ;; esac; echo \"test $f ($b)\"; quint test --backend $b \"$f\" || exit 1; done",
    "test:helpers": "quint test tests/helpers_test.qnt",
    "test:fnv": "quint test --backend typescript tests/fnv_ts_test.qnt",
    "test:forum": "quint test tests/forum_test.qnt",
    "simulate": "scripts/simulate.sh 20000 two_class",
    "simulate:one_class": "scripts/simulate.sh 20000 one_class",
    "simulate:no_user": "scripts/simulate.sh 20000 no_user",
    "simulate:1000": "scripts/simulate.sh 1000",
    "traces": "mkdir -p traces && NODE_OPTIONS=--max-old-space-size=12000 quint run instances/two_class.qnt --mbt --max-steps 40 --n-traces 300 --out-itf 'traces/t{seq}.itf.json'",
    "test:invariants": "quint test tests/invariants_test.qnt",
    "verify:holds_two": "scripts/check.sh apalache holds holds_two",
    "verify:holds_one": "scripts/check.sh apalache holds holds_one",
    "verify:keys_two": "scripts/check.sh apalache keys keys_two",
    "verify:keys_one": "scripts/check.sh apalache keys keys_one",
    "verify:people_two": "scripts/check.sh apalache people people_two",
    "verify:people_one": "scripts/check.sh apalache people people_one",
    "verify:user_two": "scripts/check.sh apalache user user_two",
    "verify:user_one": "scripts/check.sh apalache user user_one",
    "verify:user_none": "scripts/check.sh apalache user user_none",
    "verify:recurring_two": "scripts/check.sh apalache recurring recurring_two",
    "verify:recurring_one": "scripts/check.sh apalache recurring recurring_one",
    "verify:basis_two": "scripts/check.sh apalache basis basis_two",
    "verify:basis_one": "scripts/check.sh apalache basis basis_one",
    "tlc:holds_two": "scripts/check.sh tlc holds holds_two",
    "tlc:holds_one": "scripts/check.sh tlc holds holds_one",
    "tlc:keys_two": "scripts/check.sh tlc keys keys_two",
    "tlc:keys_one": "scripts/check.sh tlc keys keys_one",
    "tlc:people_two": "scripts/check.sh tlc people people_two",
    "tlc:people_one": "scripts/check.sh tlc people people_one",
    "tlc:user_two": "scripts/check.sh tlc user user_two",
    "tlc:user_one": "scripts/check.sh tlc user user_one",
    "tlc:user_none": "scripts/check.sh tlc user user_none",
    "tlc:recurring_two": "scripts/check.sh tlc recurring recurring_two",
    "tlc:recurring_one": "scripts/check.sh tlc recurring recurring_one",
    "tlc:basis_two": "scripts/check.sh tlc basis basis_two",
    "tlc:basis_one": "scripts/check.sh tlc basis basis_one",
    "liveness:holds_two": "scripts/check.sh liveness holds holds_two",
    "liveness:holds_one": "scripts/check.sh liveness holds holds_one",
    "liveness:user_two": "scripts/check.sh liveness user user_two",
    "liveness:user_one": "scripts/check.sh liveness user user_one",
    "liveness:user_none": "scripts/check.sh liveness user user_none",
    "liveness:recurring_two": "scripts/check.sh liveness recurring recurring_two",
    "liveness:recurring_one": "scripts/check.sh liveness recurring recurring_one"
  },
  "devDependencies": {
    "@informalsystems/quint": "0.33.1"
  }
}
